# ── Turso cloud database ──────────────────────────────────────────────────────
# Production: https://turso.tech
#   turso db create code-recall && turso db tokens create code-recall
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local dev (Docker — docker compose up):
#   TURSO_DATABASE_URL=http://localhost:8080
#   TURSO_AUTH_TOKEN=   (leave blank, sqld runs unauthenticated locally)

# ── Web app (Vite exposes vars with VITE_ prefix) ─────────────────────────────
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used by ai-service for card generation and evaluation
ANTHROPIC_API_KEY=sk-ant-...
